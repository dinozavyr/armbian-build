From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Radoslav Furnadzhiev <dinozavyrtrex@gmail.com>
Date: Fri, 2 Oct 2026 12:00:00 +0300
Subject: [PATCH] Bluetooth: hci_h5: add RTL8852BS compatible

btrtl already supports the RTL8852BS UART variant. Add its compatible
to hci_h5. Used by the Dusun DSGW-380.
---
--- a/drivers/bluetooth/hci_h5.c
+++ b/drivers/bluetooth/hci_h5.c
@@ -1108,6 +1108,8 @@
 	  .data = (const void *)&h5_data_rtl8723bs },
 	{ .compatible = "realtek,rtl8723cs-bt",
 	  .data = (const void *)&h5_data_rtl8822cs },
+	{ .compatible = "realtek,rtl8852bs-bt",
+	  .data = (const void *)&h5_data_rtl8822cs },
 #endif
 	{ },
 };
