From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Radoslav Furnadzhiev <dinozavyrtrex@gmail.com>
Date: Thu, 1 Oct 2026 12:00:00 +0300
Subject: [PATCH] Bluetooth: hci_h5: add RTL8852BS UART support

Add the RTL8852BS UART variant to btrtl and its compatible to hci_h5.
Used by the Dusun DSGW-380.
---
--- a/drivers/bluetooth/btrtl.c
+++ b/drivers/bluetooth/btrtl.c
@@ -182,6 +182,17 @@
 	  .fw_name  = "rtl_bt/rtl8822b_fw.bin",
 	  .cfg_name = "rtl_bt/rtl8822b_config" },
 
+	/* 8852B with UART interface */
+	{ .match_flags = IC_MATCH_FL_LMPSUBV | IC_MATCH_FL_HCIREV |
+			 IC_MATCH_FL_HCIBUS,
+	  .lmp_subver = RTL_ROM_LMP_8852A,
+	  .hci_rev = 0xb,
+	  .hci_bus = HCI_UART,
+	  .config_needed = true,
+	  .has_rom_version = true,
+	  .fw_name  = "rtl_bt/rtl8852bs_fw.bin",
+	  .cfg_name = "rtl_bt/rtl8852bs_config" },
+
 	/* 8852B */
 	{ IC_INFO(RTL_ROM_LMP_8852A, 0xb),
 	  .config_needed = false,
@@ -859,3 +870,5 @@
 MODULE_FIRMWARE("rtl_bt/rtl8822b_config.bin");
 MODULE_FIRMWARE("rtl_bt/rtl8852bu_fw.bin");
 MODULE_FIRMWARE("rtl_bt/rtl8852bu_config.bin");
+MODULE_FIRMWARE("rtl_bt/rtl8852bs_fw.bin");
+MODULE_FIRMWARE("rtl_bt/rtl8852bs_config.bin");
--- a/drivers/bluetooth/hci_h5.c
+++ b/drivers/bluetooth/hci_h5.c
@@ -1028,6 +1028,8 @@
 	  .data = (const void *)&rtl_vnd },
 	{ .compatible = "realtek,rtl8723bs-bt",
 	  .data = (const void *)&rtl_vnd },
+	{ .compatible = "realtek,rtl8852bs-bt",
+	  .data = (const void *)&rtl_vnd },
 #endif
 	{ },
 };
